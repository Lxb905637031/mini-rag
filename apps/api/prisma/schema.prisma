generator client {
  provider = "prisma-client-js"
}

datasource db {
  // 2026-09-20 起：SQLite（文件库 dev.db）切换为 PostgreSQL（Docker 容器）。
  // 原因：标准 SQL、可用 pgAdmin/DBeaver 等图形客户端查询、贴近生产环境。
  // 模型定义本身不需要改——Prisma 屏蔽了数据库差异，仅换 provider 与连接串。
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
}

/// 用户角色（RBAC 鉴权的数据源）：ADMIN=管理员（种子脚本创建并保证），
/// USER=普通用户（网页注册产生）。用 enum 而非 String：数据库层直接拒绝
/// 非法值——写入 'superadmin' 会报错，脏数据进不了库。
enum Role {
  ADMIN
  USER
}

/// 用户表：记录能登录本系统的账号。
/// 目前只有“种子管理员”一个账号（由 prisma/seed.ts 创建），不开放公开注册。
model User {
  // 用户唯一 id，cuid() 自动生成一串不重复的随机字符串。
  id String @id @default(cuid())
  // 登录用户名，@unique 保证数据库层面不允许重名。
  username String @unique
  // 密码的 bcrypt 哈希值（不是明文密码！）。
  // 注册/初始化时用 bcrypt.hash(明文密码) 计算后存入，登录时只比对哈希。
  passwordHash String
  // 昵称（展示用）。初始化时默认与用户名相同，用户以后可在个人资料中修改。
  displayName String?
  // 角色（RBAC 鉴权数据源）：登录时读出签进 JWT，RolesGuard 据此鉴权。
  // @default(USER)：加列时 PG 会把现有行自动回填为 USER（历史用户默认普通权限，
  // “安全迁移”——绝不给老数据挖坑）；admin 的 ADMIN 由种子脚本幂等保证。
  role Role @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // 该用户拥有的全部知识库（一对多关系，反向字段对应 KnowledgeBase.owner）。
  knowledgeBases KnowledgeBase[]
}

model KnowledgeBase {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]
  // 归属用户 id：数据隔离的核心字段，查询知识库时都要带上它过滤。
  // 设为可空（String?）是“安全迁移”的需要：加字段时库里可能已有旧数据，
  // 这些没有归属人的历史知识库由种子脚本回填给管理员。
  // 应用层新建知识库时该字段必填，所以正常数据不会出现 null。
  ownerId String?
  // 归属关系：ownerId 引用 User.id；用户被删除时其知识库一并删除。
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId])
}

model Document {
  id String @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  // 用户上传时的原始文件名（含中文与扩展名），展示与临时文件命名都用它。
  originalName String
  // 文件的 MIME 类型（如 application/pdf、text/plain），上传时由 multer 提供。
  mimeType String
  // 文件的二进制内容，直接存进数据库（SQLite 中对应 BLOB 类型）。
  // 新上传的文档真正内容在这里，不再写入本地磁盘；上传上限 10MB。
  // 设为可空（Bytes?）是安全迁移的需要：旧记录先建为空列，再由回填脚本把磁盘文件读入。
  content Bytes?
  // 历史遗留的本地磁盘路径：2026-09 改造前上传的文件存在 ./data/uploads。
  // 回填完成后置为 null；新上传的文档该字段一律为 null，保留字段仅为兼容旧数据。
  path String?
  status DocumentStatus @default(PENDING)
  errorMessage String?
  chunkCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks Chunk[]
  @@index([knowledgeBaseId])
  @@index([status])
}

model Chunk {
  id String @id @default(cuid())
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content String
  chunkIndex Int
  page Int?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([documentId])
}
