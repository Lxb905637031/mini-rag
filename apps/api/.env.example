DATABASE_URL="file:../../../dev.db"
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:0.6b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=mini_rag_documents
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
UPLOAD_DIR=./data/uploads

# Optional runtime settings (the root .env contains the full shared example)
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Redis 连接地址（令牌黑名单等临时数据存这里，由 docker-compose 启动）
REDIS_URL=redis://127.0.0.1:6379
# JWT 签名密钥：请改成一串足够长的随机字符串，不要在公网环境使用示例值
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# 种子管理员账号（执行 prisma db seed 时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
